<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - RSI Ahmad Yani</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 flex items-center justify-center min-h-screen font-sans p-4">
  
  <div class="bg-white p-8 sm:p-10 rounded-3xl shadow-lg shadow-slate-200/40 border border-slate-100 w-full max-w-md relative overflow-hidden">
    <div class="absolute -top-10 -right-10 w-32 h-32 bg-emerald-50 rounded-full blur-2xl opacity-70 pointer-events-none"></div>
    <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-emerald-50 rounded-full blur-2xl opacity-70 pointer-events-none"></div>

    <div class="relative z-10">
      <div class="flex justify-center mb-6">
        <div class="bg-emerald-600 text-white p-3.5 rounded-2xl shadow-md shadow-emerald-200">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        </div>
      </div>
      
      <h2 class="text-2xl font-black text-center text-slate-800 tracking-tight">RSI Ahmad Yani</h2>
      <p class="text-sm text-center text-slate-500 mb-8 font-medium">Dashboard Navigasi Indoor</p>
      
      <form action="/login" method="POST" class="space-y-5">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1.5">Username Administrator</label>
          <input type="text" name="username" placeholder="Masukkan username" class="w-full border border-slate-200 p-3 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all text-sm bg-slate-50 focus:bg-white" required>
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1.5">Password</label>
          <input type="password" name="password" placeholder="••••••••" class="w-full border border-slate-200 p-3 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all text-sm bg-slate-50 focus:bg-white" required>
        </div>
        
        <button type="submit" class="w-full bg-emerald-600 text-white p-3.5 rounded-xl hover:bg-emerald-700 font-bold shadow-md shadow-emerald-200 transition-all active:scale-[0.98] mt-2">
          Masuk ke Dashboard
        </button>
      </form>
      
      <div class="mt-8 text-center border-t border-slate-100 pt-6">
        <p class="text-xs text-slate-500 mb-1">Punya kendala saat login?</p>
        <a href="/forgot-password" class="text-sm text-emerald-600 hover:text-emerald-700 font-bold transition-colors">Reset Password di sini</a>
      </div>
    </div>
  </div>

</body>
</html>