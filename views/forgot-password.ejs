<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lupa Password - RSI Ahmad Yani</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 flex items-center justify-center min-h-screen font-sans p-4">
  <div class="bg-white p-8 sm:p-10 rounded-3xl shadow-lg shadow-slate-200/40 border border-slate-100 w-full max-w-md relative overflow-hidden">
    <!-- Aksesoris desain -->
    <div class="absolute -top-10 -right-10 w-32 h-32 bg-emerald-50 rounded-full blur-2xl opacity-70 pointer-events-none"></div>
    <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-emerald-50 rounded-full blur-2xl opacity-70 pointer-events-none"></div>
    
    <div class="relative z-10">
      <div class="flex justify-center mb-6">
        <div class="bg-emerald-600 text-white p-3.5 rounded-2xl shadow-md shadow-emerald-200">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        </div>
      </div>
      <h2 class="text-2xl font-black text-center text-slate-800 tracking-tight">Lupa Password</h2>
      <p class="text-sm text-center text-slate-500 mb-6 font-medium leading-relaxed">Masukkan email admin Anda yang terdaftar untuk menerima PIN verifikasi.</p>

      <!-- Alert Error -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-600 p-3 rounded-xl text-sm font-semibold mb-5 text-center shadow-sm">
          <%= error %>
        </div>
      <% } %>

      <form action="/forgot-password" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1.5">Email Admin</label>
          <input type="email" name="email" placeholder="contoh@gmail.com" class="w-full border border-slate-200 p-3 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all text-sm bg-slate-50 focus:bg-white" required>
        </div>
        <button type="submit" class="w-full bg-emerald-600 text-white p-3.5 rounded-xl hover:bg-emerald-700 font-bold shadow-md shadow-emerald-200 transition-all active:scale-[0.98] mt-4">
          Kirim PIN Verifikasi
        </button>
      </form>
      
      <div class="mt-8 text-center border-t border-slate-100 pt-6">
        <a href="/login" class="text-sm text-emerald-600 hover:text-emerald-700 font-bold transition-colors inline-flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Kembali ke Login
        </a>
      </div>
    </div>
  </div>
</body>
</html>