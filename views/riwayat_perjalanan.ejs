<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> - RSI Ahmad Yani</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">

  <div class="flex h-screen overflow-hidden">
    <!-- SIDEBAR -->
    <aside class="w-64 bg-white shadow-sm border-r border-slate-200 flex flex-col z-10">
      <div class="p-5 border-b border-slate-100 flex items-center gap-3">
        <div class="bg-emerald-600 text-white p-2 rounded-lg shadow-sm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        </div>
        <div>
          <h1 class="text-base font-bold text-slate-800 leading-tight">RSI Ahmad Yani</h1>
          <p class="text-xs text-emerald-600 font-semibold tracking-wide">Indoor Navigation</p>
        </div>
      </div>
      <nav class="flex-1 p-4 space-y-1.5">
        <a href="/" class="flex items-center gap-3 py-2.5 px-3 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-emerald-600 font-medium transition-colors"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg> Data User</a>
        <a href="/riwayat_perjalanan" class="flex items-center gap-3 py-2.5 px-3 rounded-lg bg-emerald-50 text-emerald-700 font-semibold transition-colors"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg> Riwayat Perjalanan</a>
        <a href="/map" class="flex items-center gap-3 py-2.5 px-3 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-emerald-600 font-medium transition-colors"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg> Data Map</a>
        <a href="/admin" class="flex items-center gap-3 py-2.5 px-3 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-emerald-600 font-medium transition-colors"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg> Data Admin</a>
      </nav>
      <div class="p-4 border-t border-slate-100">
        <a href="/logout" class="flex items-center gap-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 py-2 px-3 rounded-lg font-medium transition-colors"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg> Logout</a>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 h-full overflow-y-auto p-8" id="mainContentArea">
      <header class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
        <div>
          <h2 class="text-2xl font-bold text-slate-800"><%= title %></h2>
          <p class="text-sm text-slate-500 mt-1">Pantau rute dan riwayat navigasi pengguna.</p>
        </div>
        <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
          <!-- Filter SearchBox -->
          <div class="relative w-full sm:w-72">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5"><svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>
            <input type="text" id="searchInput" onkeyup="searchTable()" placeholder="Cari ID / Nama User / Ruangan..." class="block w-full pl-10 pr-10 py-2.5 border border-slate-200 rounded-xl text-sm bg-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all shadow-sm">
            <button id="clearSearch" onclick="clearInput()" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 hidden"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
          </div>
        </div>
      </header>

      <div class="bg-white rounded-2xl shadow-sm border border-slate-100 mb-10">
        <div class="flex justify-between items-center p-6 border-b border-slate-100">
          <h3 class="text-lg font-bold text-slate-800">Daftar User & Riwayat</h3>
        </div>
        
        <div class="overflow-x-auto">
          <!-- LOGIKA SULAP GRUPING DI EJS -->
          <% 
            let groupedMap = {};
            if (riwayat_perjalanans && riwayat_perjalanans.length > 0) {
              riwayat_perjalanans.forEach(row => {
                let key = row.id_akun_user;
                if (!groupedMap[key]) {
                  groupedMap[key] = {
                    id_akun_user: row.id_akun_user,
                    gmail: row.gmail,
                    user_id: row.user_id,
                    terbaru: row.tanggal, 
                    riwayat: []
                  };
                }
                groupedMap[key].riwayat.push(row);
              });
            }
            let groupedUsers = Object.values(groupedMap);
          %>

          <table class="w-full text-sm text-left">
            <thead>
              <tr class="bg-slate-50/50 text-slate-500 border-b border-slate-100">
                <th class="px-6 py-4 font-semibold text-center w-12">No</th>
                <th class="px-6 py-4 font-semibold">ID User</th>
                <th class="px-6 py-4 font-semibold">Akun Pengguna</th>
                <th class="px-6 py-4 font-semibold text-center">Total Perjalanan</th>
                <th class="px-6 py-4 font-semibold">Aktivitas Terakhir</th>
              </tr>
            </thead>
            <tbody id="tableBody">
              <% if (groupedUsers.length > 0) { %>
                <% groupedUsers.forEach((user, index) => { %>
                  
                  <!-- BARIS INDUK (MASTER ROW) -->
                  <tr class="data-row hover:bg-emerald-50/30 border-b border-slate-100 transition-colors" data-id="<%= user.id_akun_user %>">
                    <td class="px-6 py-4 text-center font-medium text-slate-400 number-cell">0</td> 
                    
                    <!-- TOMBOL KLIK MUNCULKAN DETAIL -->
                    <td class="px-6 py-4">
                      <button onclick="toggleDetail('detail-<%= user.id_akun_user %>')" class="font-bold text-sky-600 hover:text-sky-800 hover:underline text-base cursor-pointer transition-all focus:outline-none flex items-center gap-2" title="Klik untuk melihat detail perjalanan">
                        <%= user.id_akun_user %>
                        <svg id="icon-<%= user.id_akun_user %>" class="w-4 h-4 text-sky-500 transform transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                      </button>
                    </td>
                    
                    <td class="px-6 py-4">
                      <div class="font-bold text-emerald-600"><%= user.gmail || 'Tidak Terdaftar' %></div>
                      <div class="text-xs text-slate-400 font-medium mt-0.5 capitalize"><%= user.user_id %></div>
                    </td>
                    
                    <td class="px-6 py-4 text-center">
                      <span class="bg-emerald-100 text-emerald-700 font-bold px-3 py-1 rounded-full text-xs">
                        <%= user.riwayat.length %> Kali
                      </span>
                    </td>

                    <td class="px-6 py-4 text-slate-500 font-medium"><%= new Date(user.terbaru).toLocaleString('id-ID') %></td>

                    <!-- Span tersembunyi buat ngakalin fitur Search biar bisa cari nama ruangan -->
                    <span class="hidden"><% user.riwayat.forEach(r => { %><%= r.tujuan %> <%= r.id %> <% }) %></span>
                  </tr>

                  <!-- BARIS ANAK (DETAIL ROW - DISEMBUNYIKAN AWALNYA) -->
                  <tr id="detail-<%= user.id_akun_user %>" class="detail-row hidden bg-slate-50 border-b-2 border-slate-200">
                    <td colspan="5" class="p-0">
                      <div class="p-5 pl-16">
                        <div class="flex items-center gap-2 mb-3">
                          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                          <h4 class="font-bold text-slate-700 text-sm">Rincian Perjalanan : <span class="capitalize"><%= user.user_id %></span></h4>
                        </div>
                        
                        <div class="overflow-hidden bg-white rounded-xl border border-slate-200 shadow-sm">
                          <table class="w-full text-sm text-left">
                            <thead class="bg-slate-100 text-slate-500 text-xs">
                              <tr>
                                <th class="px-4 py-3 font-semibold">ID Trx</th>
                                <th class="px-4 py-3 font-semibold">Mulai (Scan QR)</th>
                                <th class="px-4 py-3 font-semibold">Tujuan</th>
                                <th class="px-4 py-3 font-semibold">Waktu</th>
                                <th class="px-4 py-3 font-semibold text-center">Aksi</th>
                              </tr>
                            </thead>
                            <tbody>
                              <% user.riwayat.forEach((r) => { %>
                                <tr class="border-b border-slate-50 hover:bg-slate-50/70">
                                  <td class="px-4 py-3 font-mono text-xs text-slate-400">#<%= r.id %></td>
                                  <td class="px-4 py-3">
                                    <% 
                                        let textMulai = r.mulai ? r.mulai.toString() : "";
                                        let txtKoorAwal = r.koordinat_awal ? r.koordinat_awal.toString() : "";
                                        if (textMulai.indexOf("(") !== -1) { let splitIndex = textMulai.indexOf("("); txtKoorAwal = textMulai.substring(splitIndex); textMulai = textMulai.substring(0, splitIndex).trim(); }
                                        if (txtKoorAwal) { txtKoorAwal = txtKoorAwal.replace("(", "").replace(")", "").trim(); }
                                      %>
                                      <span class="font-semibold text-slate-700"><%= textMulai %></span> 
                                      <% if (txtKoorAwal && txtKoorAwal !== "-") { %><br><span class="text-[10px] text-slate-400 font-mono"><%= txtKoorAwal %></span><% } %>
                                  </td>
                                  <td class="px-4 py-3">
                                     <% 
                                        let textTujuan = r.tujuan ? r.tujuan.toString() : "";
                                        let txtKoorTujuan = r.koordinat_tujuan ? r.koordinat_tujuan.toString() : "";
                                        if (textTujuan.indexOf("(") !== -1) { let splitIdx = textTujuan.indexOf("("); txtKoorTujuan = textTujuan.substring(splitIdx); textTujuan = textTujuan.substring(0, splitIdx).trim(); }
                                        if (txtKoorTujuan) { txtKoorTujuan = txtKoorTujuan.replace("(", "").replace(")", "").trim(); }
                                      %>
                                      <span class="font-semibold text-slate-700"><%= textTujuan %></span>
                                      <% if (txtKoorTujuan && txtKoorTujuan !== "-") { %><br><span class="text-[10px] text-slate-400 font-mono"><%= txtKoorTujuan %></span><% } %>
                                  </td>
                                  <td class="px-4 py-3 text-xs text-slate-500"><%= new Date(r.tanggal).toLocaleString('id-ID') %></td>
                                  <td class="px-4 py-3 text-center">
                                    <button type="button" onclick="bukaModalHapus('/delete-riwayat_perjalanan/<%= r.id %>')" class="text-rose-500 hover:text-rose-700 font-medium text-xs bg-rose-50 px-3 py-1.5 rounded-md transition-colors">Hapus</button>
                                  </td>
                                </tr>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr class="empty-row">
                  <td colspan="5" class="text-center py-12">
                    <div class="flex flex-col items-center justify-center text-slate-400">
                      <svg class="w-12 h-12 mb-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                      <p class="text-base font-medium">Belum ada riwayat perjalanan yang valid.</p>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- PAGINATION UI -->
        <div class="flex flex-col sm:flex-row items-center justify-between p-6 bg-white rounded-b-2xl border-t border-slate-100">
          <div class="flex items-center space-x-2 text-sm text-slate-500 mb-4 sm:mb-0">
            <span>Tampilkan</span>
            <select id="rowsPerPage" onchange="changeRowsPerPage()" class="border border-slate-200 rounded-lg text-sm focus:ring-emerald-500 focus:border-emerald-500 py-1.5 pl-3 pr-8 bg-slate-50 outline-none cursor-pointer hover:bg-slate-100 transition-colors">
              <option value="5">5</option>
              <option value="10" selected>10</option>
              <option value="20">20</option>
              <option value="50">50</option>
            </select>
            <span>user</span>
          </div>
          <div class="flex items-center space-x-4">
            <span class="text-sm text-slate-500" id="pageInfo">
              Menampilkan <span class="font-semibold text-slate-700" id="startRow">0</span> - <span class="font-semibold text-slate-700" id="endRow">0</span> dari <span class="font-semibold text-slate-700" id="totalRowsText">0</span> User
            </span>
            <nav class="isolate inline-flex -space-x-px rounded-lg shadow-sm" aria-label="Pagination">
              <button id="prevBtn" onclick="prevPage()" class="relative inline-flex items-center rounded-l-lg px-2.5 py-2 text-slate-400 ring-1 ring-inset ring-slate-200 hover:bg-slate-50 focus:z-20 disabled:opacity-50 disabled:cursor-not-allowed bg-white transition-all"><svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg></button>
              <button id="nextBtn" onclick="nextPage()" class="relative inline-flex items-center rounded-r-lg px-2.5 py-2 text-slate-400 ring-1 ring-inset ring-slate-200 hover:bg-slate-50 focus:z-20 disabled:opacity-50 disabled:cursor-not-allowed bg-white transition-all"><svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg></button>
            </nav>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- MODAL HAPUS -->
  <div id="modalHapus" class="fixed inset-0 z-50 flex items-center justify-center hidden">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="tutupModalHapus()"></div>
    <div class="bg-white text-slate-800 rounded-2xl shadow-2xl max-w-sm w-full mx-4 p-8 relative z-10 border border-slate-100">
      <div class="flex items-center space-x-3 text-rose-600 mb-4">
        <div class="bg-rose-100 p-2 rounded-full"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg></div>
        <h3 class="text-xl font-bold tracking-tight">Hapus Riwayat</h3>
      </div>
      <p class="text-slate-600 text-sm mb-8 leading-relaxed">Yakin ingin menghapus salah satu rute perjalanan ini secara permanen?</p>
      <div class="flex space-x-3 justify-end text-sm font-semibold">
        <button type="button" onclick="tutupModalHapus()" class="px-5 py-2.5 bg-slate-100 text-slate-600 rounded-xl hover:bg-slate-200 transition-colors">Batal</button>
        <a id="linkEksekusiHapus" href="#" class="px-5 py-2.5 bg-rose-600 text-white rounded-xl hover:bg-rose-700 transition-colors shadow-sm shadow-rose-200">Hapus Permanen</a>
      </div>
    </div>
  </div>

  <script>
    // JS TOGGLE AKORDION
    function toggleDetail(detailId) {
      const detailRow = document.getElementById(detailId);
      const iconId = detailId.replace('detail-', 'icon-');
      const icon = document.getElementById(iconId);
      
      if (detailRow.classList.contains('hidden')) {
        detailRow.classList.remove('hidden');
        if(icon) icon.classList.add('rotate-180');
      } else {
        detailRow.classList.add('hidden');
        if(icon) icon.classList.remove('rotate-180');
      }
    }

    function bukaModalHapus(urlDelete) { document.getElementById("linkEksekusiHapus").href = urlDelete; document.getElementById("modalHapus").classList.remove("hidden"); }
    function tutupModalHapus() { document.getElementById("modalHapus").classList.add("hidden"); document.getElementById("linkEksekusiHapus").href = "#"; }

    let currentPage = 1, rowsPerPage = 10, allRows = [], filteredRows = [];
    document.addEventListener("DOMContentLoaded", () => {
      const tbody = document.getElementById("tableBody");
      if(tbody) { 
        allRows = Array.from(tbody.getElementsByClassName("data-row")); 
        filteredRows = [...allRows]; 
        renderTable(); 
      }
    });

    function renderTable() {
      const totalRows = filteredRows.length, totalPages = Math.ceil(totalRows / rowsPerPage) || 1;
      if (currentPage > totalPages) currentPage = totalPages; if (currentPage < 1) currentPage = 1;
      const startIndex = (currentPage - 1) * rowsPerPage, endIndex = Math.min(startIndex + rowsPerPage, totalRows);
      
      // Sembunyikan semua data (termasuk tutup paksa dropdown jika ada yg lg kebuka)
      allRows.forEach(row => {
        row.style.display = "none";
        const id = row.getAttribute('data-id');
        const detailRow = document.getElementById('detail-' + id);
        if(detailRow) detailRow.classList.add('hidden');
        const icon = document.getElementById('icon-' + id);
        if(icon) icon.classList.remove('rotate-180');
      });
      
      for (let i = 0; i < totalRows; i++) {
        if (i >= startIndex && i < endIndex) { filteredRows[i].style.display = ""; }
        filteredRows[i].getElementsByClassName("number-cell")[0].innerText = i + 1;
      }
      updatePaginationUI(startIndex, endIndex, totalRows, totalPages);
    }
    
    function updatePaginationUI(start, end, total, totalPages) {
      document.getElementById("startRow").innerText = total === 0 ? 0 : start + 1;
      document.getElementById("endRow").innerText = end; document.getElementById("totalRowsText").innerText = total;
      document.getElementById("prevBtn").disabled = currentPage === 1; document.getElementById("nextBtn").disabled = currentPage === totalPages || total === 0;
    }
    function nextPage() { currentPage++; renderTable(); }
    function prevPage() { currentPage--; renderTable(); }
    function changeRowsPerPage() { rowsPerPage = parseInt(document.getElementById("rowsPerPage").value); currentPage = 1; renderTable(); }
    
    function searchTable() {
      const input = document.getElementById("searchInput"), clearBtn = document.getElementById("clearSearch"), filter = input.value.toLowerCase();
      input.value.length > 0 ? clearBtn.classList.remove('hidden') : clearBtn.classList.add('hidden');
      filteredRows = allRows.filter(row => {
        let match = false; 
        const textContent = row.textContent || row.innerText;
        if (textContent.toLowerCase().indexOf(filter) > -1) match = true;
        return match;
      });
      currentPage = 1;
      renderTable();
    }
    function clearInput() { document.getElementById("searchInput").value = ""; searchTable(); document.getElementById("searchInput").focus(); }
  </script>
</body>
</html>